<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.vogella.eclipse.installer</groupId>
	<artifactId>releng</artifactId>
	<version>1.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<eclipse.repository>https://download.eclipse.org/eclipse/updates/4.42-I-builds/I20260928-2300/</eclipse.repository>
	</properties>

	<modules>
		<module>com.vogella.eclipse.installer</module>
		<module>com.vogella.eclipse.installer.product</module>
	</modules>

	<repositories>
		<repository>
			<id>eclipse</id>
			<url>${eclipse.repository}</url>
			<layout>p2</layout>
		</repository>
	</repositories>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Pomless builds generate these executions with the product id only; Maven merges this into them. -->
				<plugin>
					<groupId>org.eclipse.tycho</groupId>
					<artifactId>tycho-p2-director-plugin</artifactId>
					<version>${tycho.version}</version>
					<executions>
						<execution>
							<id>materialize-products</id>
							<configuration>
								<products>
									<product>
										<id>com.vogella.eclipse.installer.product</id>
										<rootFolder>eclipse-installer</rootFolder>
										<archiveFileName>eclipse-installer</archiveFileName>
									</product>
								</products>
							</configuration>
						</execution>
						<execution>
							<id>archive-products</id>
							<configuration>
								<products>
									<product>
										<id>com.vogella.eclipse.installer.product</id>
										<rootFolder>eclipse-installer</rootFolder>
										<archiveFileName>eclipse-installer</archiveFileName>
									</product>
								</products>
							</configuration>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>

		<plugins>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>tycho-maven-plugin</artifactId>
				<version>${tycho.version}</version>
				<extensions>true</extensions>
			</plugin>
			<plugin>
				<groupId>org.eclipse.tycho</groupId>
				<artifactId>target-platform-configuration</artifactId>
				<version>${tycho.version}</version>
				<configuration>
					<environments>
						<environment>
							<os>win32</os>
							<ws>win32</ws>
							<arch>x86_64</arch>
						</environment>
						<environment>
							<os>linux</os>
							<ws>gtk</ws>
							<arch>x86_64</arch>
						</environment>
					</environments>
				</configuration>
			</plugin>
		</plugins>
	</build>
</project>
